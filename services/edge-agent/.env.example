EDGE_DEVICE_ID=edge-pi-01
EDGE_WELL_ID=WELL-00014
EDGE_DATA_DIR=/data
EDGE_REPLAY_FILE=
EDGE_REPLAY_SPEED=10
EDGE_HEARTBEAT_SECONDS=10
EDGE_BATCH_SIZE=256

MQTT_HOST=oil-well-ai-demo.dowdah.com
# Private address that MQTT_HOST resolves to inside the edge container. Set this
# to the ECS VPN endpoint; do not commit a real deployment address.
MQTT_CONNECT_IP=replace-with-private-vpn-address
MQTT_PORT=8883
MQTT_USERNAME=edge-pi-01
MQTT_PASSWORD=replace-at-provisioning
MQTT_TLS=true
MQTT_TOPIC_PREFIX=3w

# Host directory containing selected 3W Parquet files; never commit them.
EDGE_DATA_HOST_DIR=/home/dowdah/oilwell-data
