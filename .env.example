# Public deployment
APP_DOMAIN=oilwell.example.com
POSTGRES_DB=oilwell
POSTGRES_USER=oilwell
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://oilwell:change-me@postgres:5432/oilwell

# MQTT service and the dedicated edge-device credentials
MQTT_HOST=mosquitto
MQTT_PORT=8883
# ECS only: bind Mosquitto to its WireGuard/private-overlay address. Do not use
# 0.0.0.0 and do not expose TCP 8883 in the cloud security group.
MQTT_BIND_IP=replace-with-wireguard-private-ip
MQTT_USERNAME=edge-pi-01
MQTT_PASSWORD=change-me
API_MQTT_USERNAME=api-service
API_MQTT_PASSWORD=change-me
MQTT_TLS=true
# Leave unset for public Let’s Encrypt certificates; system trust stores validate them.
# MQTT_CA_FILE=/path/to/custom-ca.crt
MQTT_TOPIC_PREFIX=3w

# Edge agent defaults; use a mounted directory outside Git.
EDGE_DEVICE_ID=edge-pi-01
EDGE_WELL_ID=WELL-00014
EDGE_DATA_DIR=/data
EDGE_REPLAY_SPEED=10

# Read-only XGBoost inference artifact mounted into the API container.
# The directory must contain model_metadata.json and the file named by
# metadata.artifact_file. Keep model artifacts out of Git.
INFERENCE_MODEL_DIR=/models/current
SHADOW_INFERENCE_MODEL_DIR=/models/shadow
INFERENCE_ANOMALY_THRESHOLD=0.50
INFERENCE_CONFIRMATION_WINDOWS=2
INFERENCE_RECOVERY_WINDOWS=3

# Phase 4 read-only explainability and controlled teaching diagnostics.
EXPLAINABILITY_DIR=/models/explanations
DIAGNOSTIC_MIN_CONFIDENCE=0.60
DIAGNOSTIC_MAX_SOURCES=3
