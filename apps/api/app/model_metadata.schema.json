{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OilWell AI serving model metadata",
  "type": "object",
  "required": ["version", "model_type", "training_data_version", "features", "window_seconds", "stride_seconds", "class_mapping", "metrics", "created_at", "git_commit", "artifact_file", "feature_schema_version", "manifest_sha256", "parameters"],
  "properties": {
    "version": {"type": "string"},
    "model_type": {"enum": ["xgboost", "tcn"]},
    "mode": {"enum": ["active", "shadow"]},
    "training_data_version": {"type": "string"},
    "features": {"type": "array", "items": {"type": "string"}, "minItems": 7},
    "window_seconds": {"const": 180},
    "stride_seconds": {"const": 10},
    "class_mapping": {"type": "object"},
    "metrics": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string"},
    "artifact_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "feature_schema_version": {"enum": ["3w-7v-window-stats-v1", "3w-7v-tcn-v1"]},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameters": {"type": "object"},
    "config_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "scaler_file": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
  },
  "allOf": [{"if": {"properties": {"model_type": {"const": "tcn"}}}, "then": {"required": ["config_file", "scaler_file"]}}]
}
